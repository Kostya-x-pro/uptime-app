                "createdAt": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "intervalSeconds": {
                    "type": "integer"
                },
                "lastCheckedAt": {
                    "type": "string"
                },
                "lastResponseTimeMs": {
                    "type": "integer"
                },
                "status": {
                    "$ref": "#/definitions/monitor.Status"
                },
                "updatedAt": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                }
            }
        },
